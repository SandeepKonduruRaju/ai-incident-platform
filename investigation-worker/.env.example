# Copy to .env for local runs (.env is gitignored). Real environment variables override this file.
# Placeholders only: never put real passwords in this file.

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=incident-events
KAFKA_GROUP_ID=investigation-worker
KAFKA_DLQ_TOPIC=incident-events.DLQ
KAFKA_MAX_POLL_INTERVAL_MS=300000
CONSUMER_ENABLED=true

# --- Database (the compose PostgreSQL on 5433; tables live in the "worker" schema) ---
DATABASE_URL=postgresql+asyncpg://incident_app:CHANGE_ME@localhost:5433/incident_platform

# --- Retries for transient errors ---
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=10

LOG_LEVEL=INFO

# --- Embeddings (must produce 384 dimensions: worker.chunks.embedding is vector(384)) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
# EMBEDDING_CACHE_DIR=   # optional; empty = fastembed's default cache directory
# Prepended to search queries only (BGE recommendation). Set to an empty value to switch it off.
EMBEDDING_QUERY_INSTRUCTION="Represent this sentence for searching relevant passages: "

# --- Hybrid retrieval ---
RERANKER_MODEL=Xenova/ms-marco-MiniLM-L-6-v2
RETRIEVAL_WINDOW_BEFORE_MINUTES=120
RETRIEVAL_WINDOW_AFTER_MINUTES=30
RETRIEVAL_RETRIEVE_K=20
RETRIEVAL_FINAL_K=6
RETRIEVAL_SOURCE_CAPS={"log": 3, "runbook": 2, "incident": 1, "metric": 2}

# --- LLM investigation ---
# fake (default): canned answers, no key, no cost. anthropic: the real Claude API (needs the key below).
LLM_PROVIDER=fake
# Never commit a real key. Put it only in .env (gitignored) or the shell environment.
ANTHROPIC_API_KEY=
LLM_MODEL=claude-haiku-5-5
LLM_MAX_TOKENS=4096
LLM_EFFORT=low
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=3
# Must stay at most half of KAFKA_MAX_POLL_INTERVAL_MS (checked at startup).
INVESTIGATION_TIME_BUDGET_SECONDS=120
EVIDENCE_MAX_CHARS=1500

# --- Internal API (incident-service -> worker) ---
# Required: the worker refuses to start without it. Same value as incident-service's INTERNAL_API_TOKEN.
# DEV-ONLY value; use a long random secret anywhere else.
INTERNAL_API_TOKEN=dev-only-internal-token-change-me
