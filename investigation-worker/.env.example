# Copy to .env for local runs (.env is gitignored). Real environment variables override this file.
# Placeholders only: never put real passwords in this file.

# --- Kafka ---
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=incident-events
KAFKA_GROUP_ID=investigation-worker
KAFKA_DLQ_TOPIC=incident-events.DLQ
KAFKA_MAX_POLL_INTERVAL_MS=300000
CONSUMER_ENABLED=true

# --- Database (the compose PostgreSQL on 5433; tables live in the "worker" schema) ---
DATABASE_URL=postgresql+asyncpg://incident_app:CHANGE_ME@localhost:5433/incident_platform

# --- Retries for transient errors ---
RETRY_MAX_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=0.5
RETRY_MAX_DELAY_SECONDS=10

LOG_LEVEL=INFO
