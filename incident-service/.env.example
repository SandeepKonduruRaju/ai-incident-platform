# Template for local development. Copy to .env (gitignored) or set the variables in your shell.
# docker compose reads .env in this folder for ${...} substitution; the Spring app reads only real
# environment variables ($env:NAME = "..." in PowerShell). Placeholders only: never commit real values.

# --- Spring Boot app (.\mvnw.cmd spring-boot:run) ---
DB_URL=jdbc:postgresql://localhost:5433/incident_platform
DB_USERNAME=incident_app
DB_PASSWORD=CHANGE_ME
# At least 32 bytes.
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_SECRET_OF_32_BYTES_OR_MORE
# dev = enables POST /api/v1/dev/token (local tokens without an identity provider).
SPRING_PROFILES_ACTIVE=dev
INVESTIGATION_WORKER_BASE_URL=http://localhost:8001
# The outbox relay publishes incident events here (compose Kafka, EXTERNAL listener).
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# --- Shared by both services (compose passes it to the worker; the app sends it as X-Internal-Token) ---
# DEV-ONLY default, matches compose.yaml. Use a long random value anywhere else.
INTERNAL_API_TOKEN=dev-only-internal-token-change-me

# --- Investigation worker in compose ---
LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
