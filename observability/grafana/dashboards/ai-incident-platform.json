{
  "uid": "ai-incident-platform",
  "title": "AI Incident Platform",
  "description": "API RED, outbox/Kafka pipeline, investigations (SLO), LLM latency/tokens/cost/errors. Section 3.4.",
  "tags": [
    "ai-incident-platform"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
